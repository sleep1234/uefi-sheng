##
#  Xiaomi 14 Pro (shennong, SM8650) package declaration.
#  Most GUIDs/PCDs consumed by the board drivers come from SiliciumPkg /
#  QcomPkg / MdePkg. This .dec only declares the package itself so the
#  shennongPkg library classes and drivers resolve during the build.
##

[Defines]
  DEC_SPECIFICATION              = 0x00010005
  PACKAGE_NAME                   = shennongPkg
  PACKAGE_GUID                   = 9B3F2C81-4E5A-4C7D-9B1E-2D6F8A0C3E57
  PACKAGE_VERSION                = 0.1

[Includes]
  Include

[LibraryClasses]
  ##  @libraryclass  Platform memory map derived from the shennong entry DTB.
  MemoryMapLib|Library/MemoryMapLib/MemoryMapLib.inf
  ##  @libraryclass  Platform configuration map (uefiplat.cfg inputs).
  ConfigurationMapLib|Library/ConfigurationMapLib/ConfigurationMapLib.inf
